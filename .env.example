# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
# SUPABASE_SERVICE_KEY is the service role key — backend only.
# It bypasses RLS so the poller can write to processing_jobs and match_analyses.
# NEVER put this key in the Flutter app or any client-side code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Cloudflare R2 (video storage) ---
# Create a bucket at dash.cloudflare.com → R2 → Create bucket.
# Then create an API token with Object Read & Write permissions.
# R2 endpoint: https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#
# CLOUDFLARE_R2_ACCESS_KEY and CLOUDFLARE_R2_SECRET_KEY are backend-only.
# NEVER put them in the Flutter app.
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=padel-match-videos

MODAL_TOKEN_ID = ak-njLAWRInH2pZOmz5OBtoIG
MODAL_TOKEN_SECRET = as-QrRzSRtjZBDU4xkdX4gLxi
